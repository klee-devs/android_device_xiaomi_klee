soong_namespace {
    imports: [
        "hardware/xiaomi",
    ],
}

cc_library_shared {
    name: "libcppcose_rkp_legacy_compat",
    vendor: true,
    srcs: ["cppcose_rkp_legacy_compat.cpp"],
    shared_libs: ["libcppbor", "libcppcose_rkp"],
}

install_symlink {
    name: "vendor_mdota_symlink",
    vendor: true,
    installed_location: "etc/mdota",
    symlink_target: "/mnt/vendor/mdota",
}
